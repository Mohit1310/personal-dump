{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "react", "nextjs", "jsx-a11y"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"pedantic": "warn",
		"perf": "warn",
		"style": "warn"
	},
	"ignorePatterns": ["generated/**", "node_modules/**", ".next/**"]
}
